              "type": "string",
              "description": "Filter by workflow stage, e.g. 'at_port'."
            },
            "search": {
              "type": "string",
              "description": "Match part of the consignment reference."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_consignment",
        "title": "Get consignment",
        "description": "Fetch one consignment workflow by its consignment reference, including its recent tracking events.",

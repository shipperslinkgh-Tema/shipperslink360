        "description": "List consignment workflows (shipments) visible to the signed-in user, newest first. Optionally filter by workflow stage or search by consignment reference.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
